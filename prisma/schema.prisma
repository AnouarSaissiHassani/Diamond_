generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id           String        @id @default(uuid())
  firstName    String
  lastName     String
  email        String?
  phone        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  factures     Facture[]
  reglements   Reglement[]
  reservations Reservation[]
}

model Treatment {
  id           String        @id @default(uuid())
  name         String
  description  String?
  price        Float
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  factureItems FactureItem[]
  reservations Reservation[]
}

model Facture {
  id          String        @id @default(uuid())
  clientId    String
  date        DateTime      @default(now())
  totalAmount Float
  status      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  client      Client        @relation(fields: [clientId], references: [id])
  items       FactureItem[]
  reglements  Reglement[]
}

model FactureItem {
  id          String    @id @default(uuid())
  factureId   String
  treatmentId String
  quantity    Int
  unitPrice   Float
  total       Float
  facture     Facture   @relation(fields: [factureId], references: [id], onDelete: Cascade)
  treatment   Treatment @relation(fields: [treatmentId], references: [id])
}

model Reglement {
  id            String   @id @default(uuid())
  clientId      String
  factureId     String?
  date          DateTime @default(now())
  amount        Float
  paymentMethod String
  createdAt     DateTime @default(now())
  client        Client   @relation(fields: [clientId], references: [id])
  facture       Facture? @relation(fields: [factureId], references: [id])
}

model Reservation {
  id          String     @id @default(uuid())
  clientId    String
  treatmentId String?
  date        DateTime
  status      String     @default("PENDING")
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  client      Client     @relation(fields: [clientId], references: [id])
  treatment   Treatment? @relation(fields: [treatmentId], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
